# Select the LangChain chat model provider: socgenai or deepseek.
LLM_PROVIDER=deepseek

# SocGenAI model routing. GENAI_MODEL continues to configure general chat.
GENAI_MODEL=your-general-chat-model
SOCGENAI_LOW_COST_MODEL=gpt-5-mini
SOCGENAI_HIGH_COST_MODEL=gpt-5.4
SOCGENAI_MAX_COMPLETION_TOKENS=128000

# DeepSeek credentials and model routing. DEEPSEEK_MODEL configures general
# chat and review roots; review peers use the explicit low/high-cost roles.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_LOW_COST_MODEL=deepseek-v4-flash
DEEPSEEK_HIGH_COST_MODEL=deepseek-v4-pro
DEEPSEEK_MAX_TOKENS=384000
DEEPSEEK_MAX_RETRIES=5

# MCP server settings.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Read-only source material exposed by list/search/read MCP tools.
# Relative paths resolve from the checkout root, or the working directory when installed.
SOURCE_ROOT=sources
# Optional trusted deployed skill root; otherwise use bundled skills.
# SKILLS_DIR=/absolute/path/to/skills

# Host-owned storage for trusted analysis results and pending candidate drafts.
REVIEW_WORKSPACE=.analysis_workspace/review-skills
# Optional trusted host bindings: a bound MCP server exposes review capabilities only.
# REVIEW_RUN_ID=RUN-example
# REVIEW_ASSIGNMENT_ID=task-host-created-id
# REVIEW_OUTPUT_DIR=/absolute/path/to/run
# Review peers use the provider low/high-cost settings above; these budgets apply
# on a host-bound root review (review commands enable peers automatically).
REVIEW_CHILD_MAX_RUNS=160
REVIEW_CHILD_MAX_CONCURRENCY=4
REVIEW_CHILD_MAX_MODEL_CALLS=18
REVIEW_CHILD_MAX_TOOL_CALLS=32
REVIEW_CHILD_TIMEOUT_SECONDS=240
REVIEW_CHILD_MAX_INPUT_CHARS=120000
REVIEW_CHILD_MAX_RESULT_CHARS=64000
# Aggregate durable limits persist across root turns and process restarts.
REVIEW_MAX_MODEL_CALLS=1200
REVIEW_MAX_TOOL_CALLS=3000
REVIEW_MAX_ACTIVE_SECONDS=7200
REVIEW_ROOT_MAX_ITERATIONS=200

# Agent settings.
AGENT_MAX_ITERATIONS=10

# Conversational sub-agent delegation is opt-in. Limits apply per root
# invocation and keep child work bounded.
SUBAGENTS_ENABLED=false
SUBAGENT_MAX_RUNS=4
SUBAGENT_MAX_CONCURRENCY=2
SUBAGENT_MAX_MODEL_CALLS=6
SUBAGENT_MAX_TOOL_CALLS=12
SUBAGENT_TIMEOUT_SECONDS=120
SUBAGENT_MAX_INPUT_CHARS=16000
SUBAGENT_MAX_RESULT_CHARS=8000

# Operational trace result previews are disabled by default. Set a bounded
# value from 1 through 4000 to retain redacted tool-result previews.
TRACE_RESULT_PREVIEW_CHARS=0
LOG_LEVEL=INFO
